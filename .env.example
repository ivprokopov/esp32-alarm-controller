# Copy to .env and fill the values. Keep .env private.
ALARM_DB=/data/alarm.db
CONTROLLER_URL=http://192.168.0.218:8088
CONTROLLER_KEY=CHANGE_ME_SAME_AS_ESPHOME_alarm_control_key
SHELLY_WEBHOOK_KEY=CHANGE_ME_SAME_AS_ESPHOME_shelly_webhook_key
CONTROLLER_WEBHOOK_URL=http://192.168.0.218:8081/shelly
ALARM_ADMIN_USER=admin
ALARM_ADMIN_PASSWORD=CHANGE_ME_NOW
SESSION_HOURS=12

# Automatically programs the two known Shelly Plus i4 modules on first start.
AUTO_CONFIGURE_SHELLY=1
